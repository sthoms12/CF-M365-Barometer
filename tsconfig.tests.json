{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types", "@types/node"],
    "skipLibCheck": true
  },
  "include": ["src/worker/**/*.test.ts", "src/worker/secrets.d.ts", "src/shared/**/*.ts", "worker-configuration.d.ts"]
}
